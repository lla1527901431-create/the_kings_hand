# ============================================================================
# The King's Hand（SQLite 版）—— 环境变量样例
# ============================================================================
# 用法：复制成 .env 后按需修改。所有项都有默认值，**不配也能跑**。
#     copy .env.example .env
#
# 注意：这里没有 DEEPSEEK_API_KEY / AMAP_API_KEY —— 这两个由管理员在
# 页面的「访问管理」里填，AES-256-GCM 加密后存进 SQLite（见 db/crypto.py）。
# ============================================================================

# ---- DeepSeek（模型与地址是服务端配置，Key 由管理员在页面上填）----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MEMORY_MODEL=deepseek-v4-flash

# ---- 密钥加密 ----
# 加密 API Key 用的主密钥（AES-256-GCM）。**不配也能跑**：
#   不配 -> 首次启动自动生成 data/.secret_key（权限 0600），随 data/ 一起备份
#   配了 -> 用它，不落盘。容器/托管环境建议用这种方式注入。
# 生成方法（任选其一都可以）：
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   KH_SECRET_KEY=随便一段很长很乱的口令
# ⚠️ 换密钥后旧密文解不开，界面上会显示"未配置"，重填一次 API Key 即可。
# KH_SECRET_KEY=

# ---- 数据库位置 ----
# 留空则用 data/app.db（连同 data 目录一起拷贝即可迁移数据）
# DB_PATH=

# ---- 运行模式 ----
# ⚠️ 注意：config.py 把"环境里出现 PORT"当作托管环境的标志（会关掉热重载）。
#    本机调试想改端口，请用命令行 `PORT=8010 python main.py`，
#    不要在 .env 里写 PORT，否则热重载会被静默关闭。
HOST=127.0.0.1
# PORT=8000
DEBUG=true          # true 开启热重载（改代码自动重启），本地演示方便
LOG_LEVEL=INFO

# 会话 cookie 是否带 Secure：本地 http 必须 false；部署到 HTTPS 时设 true
# （HTTPS 下代码还会看 X-Forwarded-Proto，两者取"是"）
COOKIE_SECURE=false

# 登录有效期（天）。白名单登录没有 refresh 机制，过期重新输手机号即可
SESSION_DAYS=30

# 对话上下文：每人保留最近多少条消息（一问一答算 2 条）
RECENT_HISTORY_MAX=10
