# ============================================================================
# The King's Hand（本地演示版）—— 环境变量样例
# ============================================================================
# 用法：复制成 .env 后按需修改。所有项都有默认值，**不配也能跑**。
#     copy .env.example .env
#
# 注意：这里没有 DEEPSEEK_API_KEY —— 用户自己的 Key 由用户在页面上填，
# 明文存在 SQLite 里（见 README 的安全说明）。
# ============================================================================

# ---- DeepSeek（模型与地址是服务端配置；key 由用户自己填）----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MEMORY_MODEL=deepseek-v4-flash

# ---- 数据库位置 ----
# 留空则用 data/app.db（连同 data 目录一起拷贝即可迁移数据）
# DB_PATH=F:\Project_2_langchain\the_kings_hand_demo\data\app.db

# ---- 运行模式 ----
HOST=127.0.0.1
PORT=8000
DEBUG=true          # true 开启热重载（改代码自动重启），本地演示方便
LOG_LEVEL=INFO

# 会话 cookie 是否带 Secure：本地 http 必须 false；部署到 HTTPS 时设 true
COOKIE_SECURE=false

# 登录有效期（天）。白名单登录没有 refresh 机制，过期重新输手机号即可
SESSION_DAYS=30

# 对话上下文：最多保留多少条消息；多久没活动就清掉
RECENT_HISTORY_MAX=10
RECENT_HISTORY_IDLE_MINUTES=120
